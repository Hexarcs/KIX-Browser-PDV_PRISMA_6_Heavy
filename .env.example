# browser-POS — copie para .env e preencha. Nunca versione o .env real.
SECRET_KEY=troque-por-uma-chave-aleatoria-longa
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Domínios com HTTPS que podem enviar POST (separados por vírgula).
CSRF_TRUSTED_ORIGINS=

# LNbits: URL completa do endpoint de pagamentos e chave de invoice.
LNBITS_URL=https://seu-lnbits.exemplo/api/v1/payments
LNBITS_API_KEY=sua-chave-de-invoice-aqui
LNBITS_TIMEOUT=10

# Limites aceitos pelo terminal e validados novamente no backend.
POS_MIN_SATS=1
POS_MAX_SATS=1000000
POS_INVOICE_TTL_SECONDS=3600

# Opcional: caminho do SQLite. Vazio usa data/db.sqlite3 se existir,
# senão db.sqlite3 no diretório do projeto.
DATABASE_PATH=

# Opcional para HTTPS atrás de proxy reverso confiável.
TRUST_PROXY_HEADERS=False
SESSION_COOKIE_SECURE=
CSRF_COOKIE_SECURE=
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
